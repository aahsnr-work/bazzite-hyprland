{
  "pandocPath": "/usr/bin/pandoc",
  "pdflatexPath": "/usr/bin/pdflatex",
  "outputFolder": "same as input",
  "enabledExportFormats": {
    "pdf": true,
    "latex": true,
    "docx": false,
    "html": false
  },
  "extraArgumentsForAllFormats": "--citeproc --number-sections --toc --toc-depth=2",
  "extraArgumentsForLatex": "--pdf-engine=pdflatex --standalone",
  "bibliographyFile": "References.bib",
  "citationStyleFile": "Templates/chicago-author-date.csl",
  "customLatexTemplate": "Templates/paper-template.tex"
}
